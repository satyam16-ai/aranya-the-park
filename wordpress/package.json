{
  "name": "aranya-wordpress",
  "private": true,
  "type": "module",
  "description": "Build tooling for the Aranya The Park WordPress theme and Aranya Core plugin.",
  "scripts": {
    "build:icons": "node build/extract-icons.mjs",
    "build:fonts": "node build/fetch-fonts.mjs",
    "build:manifest": "node build/build-manifest.mjs",
    "build:css": "node build/build-css.mjs",
    "watch:css": "node build/build-css.mjs --watch",
    "build": "npm run build:icons && npm run build:manifest && npm run build:defaults && npm run build:js && npm run build:css",
    "package": "npm run build && node build/package.mjs",
    "build:defaults": "node build/export-defaults.mjs",
    "build:js": "node build/build-js.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "alpinejs": "3.17.4",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.12",
    "tailwindcss": "4.3.3"
  }
}
